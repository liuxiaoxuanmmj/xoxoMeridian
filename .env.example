# =============================================================================
# REQUIRED — startup will refuse to boot if any of these are missing/empty.
# Generate strong values:
#   POSTGRES_PASSWORD: openssl rand -base64 32
#   SESSION_SECRET:    openssl rand -base64 48
#   INVITE_CODE:       any shared invite token (>=8 chars). Both registrants
#                      must enter this exact value to join the only room.
# =============================================================================
POSTGRES_PASSWORD=__GENERATE_STRONG_RANDOM__
SESSION_SECRET=__GENERATE_AT_LEAST_32_CHARS_RANDOM__
INVITE_CODE=__SET_BEFORE_DEPLOY__
APP_BASE_URL=https://your-domain.example.com
NEXT_PUBLIC_APP_URL=https://your-domain.example.com

# Optional: comma-separated extra origins allowed for CSRF Origin check.
# Useful when the same deployment is reachable via both IP and domain, e.g.
#   ALLOWED_ORIGINS=http://154.12.28.37,http://10.0.0.5
ALLOWED_ORIGINS=

# =============================================================================
# OPTIONAL — sensible defaults applied at startup.
# =============================================================================
SESSION_MAX_AGE_SECONDS=604800     # 7 days
PASSWORD_MIN_LENGTH=8

DEMO_ROOM_SLUG=our-room

# --- LLM ---
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=20000

# --- Email ---
# EMAIL_PROVIDER: "mock" (default, logs to console), "resend", "turbosmtp", 或 "smtp"
#
# Resend 配置:
#   - API Key 申请: https://resend.com/api-keys
#   - EMAIL_FROM: 必须是已验证的域名（免费版可用 onboarding@resend.dev 测试）
#
# TurboSMTP API 配置:
#   - 注册账号: https://serversmtp.com/ (免费 6000 封/月)
#   - 从 Dashboard 获取 Consumer Key 和 Consumer Secret
#   - EMAIL_FROM: 可使用任意邮箱地址（无需域名验证）
#   - TURBOSMTP_REGION: "us" (默认) 或 "eu" (欧盟用户)
#   - 详细配置: 参见 docs/turbosmtp-setup.md
#
# SMTP 通用配置（支持 TurboSMTP SMTP、Gmail SMTP 等）:
#   - EMAIL_PROVIDER=smtp
#   - SMTP_HOST: SMTP 服务器地址（如 pro.turbo-smtp.com）
#   - SMTP_PORT: 587 (STARTTLS) 或 465 (SSL)
#   - SMTP_SECURE: false (587端口) 或 true (465端口)
#   - SMTP_USER: SMTP 用户名
#   - SMTP_PASSWORD: SMTP 密码
#   - 详细配置: 参见 TURBOSMTP_SMTP_CONFIG.md
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=noreply@your-domain.example.com

# TurboSMTP API 专用配置（仅当 EMAIL_PROVIDER=turbosmtp 时需要）
TURBOSMTP_CONSUMER_KEY=
TURBOSMTP_CONSUMER_SECRET=
TURBOSMTP_REGION=us

# SMTP 通用配置（仅当 EMAIL_PROVIDER=smtp 时需要）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Weather ---
# WEATHER_PROVIDER: "mock" (default) 或 "qweather" 使用和风天气 API
# 申请 API Key: https://console.qweather.com/
#
# 2024 年起新注册用户必须使用控制台分配的【专属 API Host】，形如
#   k12abc34de.re.qweatherapi.com
# 把它同时填到下面两项（天气 API 和 GeoAPI 共用同一个专属 Host）。
#
# 老用户可继续使用通用域名 devapi.qweather.com + geoapi.qweather.com。
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
WEATHER_BASE_URL=
QWEATHER_API_HOST=devapi.qweather.com
QWEATHER_GEOAPI_HOST=geoapi.qweather.com

# --- Tavily Search API ---
# TAVILY_API_KEY: Optional, falls back to mock when empty
# Get your API key at: https://tavily.com
# Free tier provides a certain number of search credits
TAVILY_API_KEY=

# --- Agent runtime ---
# In docker compose deployments AGENT_TASK_INLINE_RUN must be "false" so the
# agent-worker container handles tasks asynchronously. Inline mode is for local
# dev only.
AGENT_TASK_INLINE_RUN=false
AGENT_WORKER_POLL_MS=3000
# Set to "true" to write per-room JSONL chat logs (incl. LLM raw payloads
# and tool calls) under data/chat-logs/. Leave false in production unless
# actively debugging.
AGENT_DEBUG_ENABLED=false

# --- Atlas ---
# Directory for storing uploaded Atlas photos (default: data/atlas-uploads).
# In Docker, this is mounted as a volume.
# ATLAS_UPLOAD_DIR=data/atlas-uploads

# =============================================================================
# Local (non-docker) dev only. docker-compose builds DATABASE_URL from
# POSTGRES_PASSWORD above and ignores these.
# =============================================================================
DATABASE_URL=
DIRECT_URL=
