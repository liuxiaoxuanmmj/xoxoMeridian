# =============================================================================
# REQUIRED — startup will refuse to boot if any of these are missing/empty.
# Generate strong values:
#   POSTGRES_PASSWORD: openssl rand -base64 32
#   SESSION_SECRET:    openssl rand -base64 48
#   DEMO_LOGIN_PASSWORD: anything you share with both demo users (>=8 chars)
# =============================================================================
POSTGRES_PASSWORD=__GENERATE_STRONG_RANDOM__
SESSION_SECRET=__GENERATE_AT_LEAST_32_CHARS_RANDOM__
DEMO_LOGIN_PASSWORD=__SET_BEFORE_DEPLOY__
APP_BASE_URL=https://your-domain.example.com
NEXT_PUBLIC_APP_URL=https://your-domain.example.com

# Optional: comma-separated extra origins allowed for CSRF Origin check.
# Useful when the same deployment is reachable via both IP and domain, e.g.
#   ALLOWED_ORIGINS=http://154.12.28.37,http://10.0.0.5
ALLOWED_ORIGINS=

# =============================================================================
# OPTIONAL — sensible defaults applied at startup.
# =============================================================================
SESSION_MAX_AGE_SECONDS=604800     # 7 days

DEMO_ROOM_SLUG=our-room
DEMO_MY_EMAIL=me@example.com
DEMO_HER_EMAIL=her@example.com

# --- LLM ---
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=20000

# --- Weather ---
# WEATHER_PROVIDER: "mock" (default) 或 "qweather" 使用和风天气 API
# 申请 API Key: https://console.qweather.com/
#
# 2024 年起新注册用户必须使用控制台分配的【专属 API Host】，形如
#   k12abc34de.re.qweatherapi.com
# 把它同时填到下面两项（天气 API 和 GeoAPI 共用同一个专属 Host）。
#
# 老用户可继续使用通用域名 devapi.qweather.com + geoapi.qweather.com。
WEATHER_PROVIDER=mock
WEATHER_API_KEY=
WEATHER_BASE_URL=
QWEATHER_API_HOST=devapi.qweather.com
QWEATHER_GEOAPI_HOST=geoapi.qweather.com

# --- Agent runtime ---
# In docker compose deployments AGENT_TASK_INLINE_RUN must be "false" so the
# agent-worker container handles tasks asynchronously. Inline mode is for local
# dev only.
AGENT_TASK_INLINE_RUN=false
AGENT_WORKER_POLL_MS=3000

# =============================================================================
# Local (non-docker) dev only. docker-compose builds DATABASE_URL from
# POSTGRES_PASSWORD above and ignores these.
# =============================================================================
DATABASE_URL=
DIRECT_URL=
